---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Dosages, timing, and Adderall compatibility for ADHD supplements."
} = Astro.props;

// WebMCP origin trial token for the deployed origin (optional; set in Netlify env)
const webmcpToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111110" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload fonts used above the fold to limit layout shift -->
    <link rel="preload" href="/fonts/lexend-deca-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />

    {webmcpToken && <meta http-equiv="origin-trial" content={webmcpToken} />}

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 py-8 border-t border-surface-border text-xs text-ink-faint leading-relaxed">
      Not medical advice. Check with a doctor before starting supplements, especially alongside stimulants.
    </footer>

    <script>
      // Read-only catalog tools for in-browser AI agents (WebMCP).
      // Loaded only when the browser supports it, so other visitors download nothing.
      import { getModelContext, registerTools } from "../lib/webmcp/model-context";
      if (getModelContext()) {
        import("../lib/webmcp/catalog-tools").then(({ catalogTools }) =>
          registerTools(catalogTools, new AbortController().signal)
        );
      }
    </script>
  </body>
</html>
