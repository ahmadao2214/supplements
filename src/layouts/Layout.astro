---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Interactive database of supplements for ADHD/ADD management — dosages, timing, Adderall compatibility, and more."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0e0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload fonts used above the fold to limit layout shift -->
    <link rel="preload" href="/fonts/lexend-deca-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <footer class="max-w-7xl mx-auto px-4 sm:px-6 py-8 border-t border-surface-border text-xs text-ink-faint leading-relaxed">
      For information only — not medical advice. Talk to a healthcare professional before starting supplements, especially alongside prescription stimulants.
    </footer>
  </body>
</html>
