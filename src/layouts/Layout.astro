---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Interactive database of supplements for ADHD/ADD management — dosages, timing, Adderall compatibility, and more."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #0f1117;
    --surface: #1a1d27;
    --surface-hover: #22263a;
    --border: #2a2e3f;
    --text: #e1e4ed;
    --text-muted: #8b90a0;
    --primary: #6c8cff;
    --primary-dim: #4a6ae0;
    --safe: #34d399;
    --safe-bg: rgba(52, 211, 153, 0.12);
    --caution: #fbbf24;
    --caution-bg: rgba(251, 191, 36, 0.12);
    --avoid: #f87171;
    --avoid-bg: rgba(248, 113, 113, 0.12);
    --tier1: #34d399;
    --tier1-bg: rgba(52, 211, 153, 0.12);
    --tier2: #60a5fa;
    --tier2-bg: rgba(96, 165, 250, 0.12);
    --tier3: #a78bfa;
    --tier3-bg: rgba(167, 139, 250, 0.12);
    --schedule-daily: #6ee7b7;
    --schedule-daily-bg: rgba(110, 231, 183, 0.1);
    --schedule-adderall: #93c5fd;
    --schedule-adderall-bg: rgba(147, 197, 253, 0.1);
    --schedule-off: #fcd34d;
    --schedule-off-bg: rgba(252, 211, 77, 0.1);
    --schedule-evening: #c4b5fd;
    --schedule-evening-bg: rgba(196, 181, 253, 0.1);
    --radius: 8px;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    min-height: 100vh;
  }

  /* Header */
  .header {
    padding: 2rem 1.5rem 1rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.25rem;
  }

  .header p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .disclaimer {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--caution-bg);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: var(--radius);
    font-size: 0.82rem;
    color: var(--caution);
  }

  /* Table container */
  .table-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 1rem 1.5rem 2rem;
  }

  /* Filters */
  .filters {
    margin-bottom: 1rem;
  }

  .filter-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .search-box {
    flex: 1;
    min-width: 240px;
  }

  .search-box input {
    width: 100%;
    padding: 0.6rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.15s;
  }

  .search-box input:focus {
    border-color: var(--primary);
  }

  .search-box input::placeholder {
    color: var(--text-muted);
  }

  select {
    padding: 0.6rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
    min-width: 150px;
  }

  select:focus {
    border-color: var(--primary);
  }

  /* Column toggles */
  .column-toggles {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0;
  }

  .column-toggles summary {
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-muted);
    user-select: none;
  }

  .column-toggles summary:hover {
    color: var(--text);
  }

  .toggle-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.5rem 0.85rem 0.75rem;
  }

  .toggle-grid label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    cursor: pointer;
  }

  .toggle-grid label:hover {
    color: var(--text);
  }

  .toggle-grid input[type="checkbox"] {
    accent-color: var(--primary);
  }

  /* Results count */
  .results-count {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  /* Table */
  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  thead {
    position: sticky;
    top: 0;
    z-index: 10;
  }

  th {
    background: var(--surface);
    padding: 0.7rem 0.75rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text-muted);
    border-bottom: 2px solid var(--border);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }

  th:hover {
    color: var(--primary);
  }

  th.sorted-asc,
  th.sorted-desc {
    color: var(--primary);
  }

  .sort-arrow {
    font-size: 0.7rem;
  }

  td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    max-width: 280px;
  }

  tbody tr {
    cursor: pointer;
    transition: background 0.1s;
  }

  tbody tr:hover {
    background: var(--surface-hover);
  }

  .expand-col {
    width: 50px;
    text-align: center;
  }

  .expand-btn {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .expand-btn:hover {
    background: var(--primary-dim);
    border-color: var(--primary);
  }

  /* Badges */
  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .badge-safe {
    background: var(--safe-bg);
    color: var(--safe);
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .badge-caution {
    background: var(--caution-bg);
    color: var(--caution);
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .badge-avoid {
    background: var(--avoid-bg);
    color: var(--avoid);
    border: 1px solid rgba(248, 113, 113, 0.3);
  }

  /* Tier badges */
  .badge-tier1 {
    background: var(--tier1-bg);
    color: var(--tier1);
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .badge-tier2 {
    background: var(--tier2-bg);
    color: var(--tier2);
    border: 1px solid rgba(96, 165, 250, 0.3);
  }

  .badge-tier3 {
    background: var(--tier3-bg);
    color: var(--tier3);
    border: 1px solid rgba(167, 139, 250, 0.3);
  }

  /* Schedule badges */
  .badge-schedule-daily {
    background: var(--schedule-daily-bg);
    color: var(--schedule-daily);
    border: 1px solid rgba(110, 231, 183, 0.25);
    font-size: 0.7rem;
  }

  .badge-schedule-adderall {
    background: var(--schedule-adderall-bg);
    color: var(--schedule-adderall);
    border: 1px solid rgba(147, 197, 253, 0.25);
    font-size: 0.7rem;
  }

  .badge-schedule-off {
    background: var(--schedule-off-bg);
    color: var(--schedule-off);
    border: 1px solid rgba(252, 211, 77, 0.25);
    font-size: 0.7rem;
  }

  .badge-schedule-evening {
    background: var(--schedule-evening-bg);
    color: var(--schedule-evening);
    border: 1px solid rgba(196, 181, 253, 0.25);
    font-size: 0.7rem;
  }

  /* Tier legend */
  .tier-legend {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .tier-legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tier-legend-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* Tier row full-row coloring */
  .tier-row {
    border-left: 3px solid transparent;
  }

  .tier-row-1 {
    background: rgba(52, 211, 153, 0.06);
    border-left: 3px solid var(--tier1);
  }

  .tier-row-1:hover {
    background: rgba(52, 211, 153, 0.12) !important;
  }

  .tier-row-2 {
    background: rgba(96, 165, 250, 0.06);
    border-left: 3px solid var(--tier2);
  }

  .tier-row-2:hover {
    background: rgba(96, 165, 250, 0.12) !important;
  }

  .tier-row-3 {
    background: rgba(167, 139, 250, 0.05);
    border-left: 3px solid var(--tier3);
  }

  .tier-row-3:hover {
    background: rgba(167, 139, 250, 0.10) !important;
  }

  /* Buy link */
  .buy-link {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--primary-dim);
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    transition: background 0.15s;
  }

  .buy-link:hover {
    background: var(--primary);
  }

  .buy-pending {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  /* Detail row */
  .detail-row {
    background: var(--surface) !important;
  }

  .detail-row:hover {
    background: var(--surface) !important;
  }

  .detail-card {
    padding: 1rem 0.5rem;
  }

  .detail-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .detail-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0;
    color: var(--primary);
  }

  .tier-reason {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding: 0.4rem 0.6rem;
    background: rgba(108, 140, 255, 0.06);
    border-left: 3px solid var(--primary);
    border-radius: 0 4px 4px 0;
  }

  .tier-reason strong {
    color: var(--primary);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.6rem 1.5rem;
  }

  .detail-grid strong {
    color: var(--text-muted);
  }

  .detail-grid .full-width {
    grid-column: 1 / -1;
  }

  /* No results */
  .no-results {
    text-align: center;
    padding: 2rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header {
      padding: 1.25rem 1rem 0.75rem;
    }

    .header h1 {
      font-size: 1.35rem;
    }

    .table-container {
      padding: 0.75rem 1rem 2rem;
    }

    .filter-row {
      flex-direction: column;
    }

    select {
      min-width: 100%;
    }

    td {
      font-size: 0.8rem;
      max-width: 200px;
    }

    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
