---
import Layout from "../layouts/Layout.astro";
import SupplementDatabase from "../components/supplements/SupplementDatabase";
import { supplements } from "../data/supplements";

// Fetch prices from Swanson's Shopify API at build time
const prices: Record<number, number> = {};
const suppsWithUrls = supplements.filter(s => s.purchaseUrl);

await Promise.all(suppsWithUrls.map(async (s) => {
  try {
    const handleMatch = s.purchaseUrl.match(/\/p\/([^?]+)/);
    if (!handleMatch) return;
    const res = await fetch(`https://www.swansonvitamins.com/products/${handleMatch[1]}.json`);
    if (!res.ok) return;
    const data = await res.json();
    const variantId = s.purchaseUrl.match(/variant=(\d+)/)?.[1];
    const variant = data.product?.variants?.find((v: any) => String(v.id) === variantId);
    if (variant?.price) prices[s.id] = parseFloat(variant.price);
  } catch { /* graceful fallback — no price shown */ }
}));
---

<Layout title="ADHD Supplement Database">
  <!-- Hero gradient header -->
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-sage-800/40 via-surface-900 to-depth-800/30"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-4">
      <h1 class="font-display text-2xl sm:text-3xl font-bold text-sage-200 tracking-tight">
        ADHD / ADD Supplement Database
      </h1>
      <p class="mt-1 text-sm sm:text-base text-sage-400/80 font-body">
        Interactive reference table — dosages, timing, Adderall compatibility, and more.
      </p>
      <div class="mt-3 px-4 py-3 rounded-xl bg-caution-bg border border-caution-border text-sm text-caution font-body">
        This is for informational purposes only and is not medical advice. Always
        consult with a healthcare professional before starting any supplement
        regimen, especially when combining with prescription medications like
        Adderall.
      </div>
    </div>
  </div>
  <SupplementDatabase prices={prices} client:load />
</Layout>
