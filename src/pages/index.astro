---
import Layout from "../layouts/Layout.astro";
import SupplementDatabase from "../components/supplements/SupplementDatabase";
import { supplements } from "../data/supplements";

// Fetch prices from Swanson's Shopify API at build time
const prices: Record<number, number> = {};
const suppsWithUrls = supplements.filter(s => s.purchaseUrl);

await Promise.all(suppsWithUrls.map(async (s) => {
  try {
    const handleMatch = s.purchaseUrl.match(/\/p\/([^?]+)/);
    if (!handleMatch) return;
    const res = await fetch(`https://www.swansonvitamins.com/products/${handleMatch[1]}.json`);
    if (!res.ok) return;
    const data = await res.json();
    const variantId = s.purchaseUrl.match(/variant=(\d+)/)?.[1];
    const variant = data.product?.variants?.find((v: any) => String(v.id) === variantId);
    if (variant?.price) prices[s.id] = parseFloat(variant.price);
  } catch { /* graceful fallback — no price shown */ }
}));
---

<Layout title="ADHD Supplement Database">
  <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 sm:pt-14 pb-6 sm:pb-8">
    <p class="eyebrow mb-3">Evidence-ranked reference</p>
    <h1 class="font-serif text-[2rem] leading-[1.1] sm:text-5xl font-semibold">
      ADHD Supplement Database
    </h1>
    <p class="mt-3 max-w-2xl text-[0.9375rem] sm:text-base text-ink-muted leading-relaxed">
      Dosage, timing, and Adderall compatibility for {supplements.length} supplements,
      ranked <span class="text-tier1-text">Core</span>, <span class="text-tier2-text">Add-On</span>
      and <span class="text-tier3-text">Optional</span> by strength of evidence.
    </p>
  </header>
  <main>
    <SupplementDatabase prices={prices} client:load />
  </main>
</Layout>
