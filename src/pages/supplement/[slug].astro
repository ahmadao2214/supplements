---
import Layout from "../../layouts/Layout.astro";
import SupplementDetail from "../../components/supplements/SupplementDetail";
import { supplements, type Supplement } from "../../data/supplements";
import { getRelatedSupplements } from "../../lib/supplement-utils";
import { classifyTimeOfDay, classifyMeals, getTimeLabel, getMealLabel } from "../../lib/format-utils";
import { TierLabel, AdderallLabel, ScheduleLabel, TimeLabel, MealLabel } from "../../components/ui/SupplementBadges";
import { TierIcon } from "../../components/ui/Icons";

export function getStaticPaths() {
  return supplements.map((s) => ({
    params: { slug: s.slug },
    props: { supplement: s },
  }));
}

interface Props {
  supplement: Supplement;
}

const { supplement: s } = Astro.props;
const related = getRelatedSupplements(s, 4);
const timeType = classifyTimeOfDay(s.timeOfDay);
const mealType = classifyMeals(s.withMeals);

// Fetch price for this supplement
let price: number | undefined;
if (s.purchaseUrl) {
  try {
    const handleMatch = s.purchaseUrl.match(/\/p\/([^?]+)/);
    if (handleMatch) {
      const res = await fetch(`https://www.swansonvitamins.com/products/${handleMatch[1]}.json`);
      if (res.ok) {
        const data = await res.json();
        const variantId = s.purchaseUrl.match(/variant=(\d+)/)?.[1];
        const variant = data.product?.variants?.find((v: any) => String(v.id) === variantId);
        if (variant?.price) price = parseFloat(variant.price);
      }
    }
  } catch { /* graceful fallback */ }
}

// Show the raw text under a label only when it adds information
const timeNote = timeType && s.timeOfDay !== getTimeLabel(timeType) ? s.timeOfDay : null;
const mealNote = mealType && s.withMeals !== getMealLabel(mealType) ? s.withMeals : null;
---

<Layout title={`${s.name} — ADHD Supplements`} description={`${s.name}${s.form ? ` (${s.form})` : ""}: ${s.treats}. ${s.benefits}`}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-4 sm:pt-8 pb-12">
    <a href="/" class="inline-flex items-center gap-1.5 min-h-11 -ml-1 px-1 text-sm text-ink-muted hover:text-ink transition-colors focus-ring">
      <span aria-hidden="true">←</span> All supplements
    </a>

    <header class="mt-2 mb-6">
      <h1 class="font-serif text-[2rem] leading-tight sm:text-5xl font-semibold">{s.name}</h1>
      {s.form && <p class="mt-1 text-lg text-ink-muted">{s.form}</p>}
      <p class="mt-5 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft">
        <TierLabel supplement={s} />
        <span class="text-ink-faint"> — </span>
        <span class="font-body">{s.tierReason}</span>
      </p>
    </header>

    {s.purchaseUrl && (
      <section class="panel p-4 mb-6" aria-label="Buy">
        <SupplementDetail supplement={s} price={price} client:visible />
      </section>
    )}

    <section class="panel mb-8" aria-labelledby="glance">
      <h2 id="glance" class="sr-only">At a glance</h2>
      <dl class="grid grid-cols-2 md:grid-cols-3 text-sm text-ink-soft">
        <div class="p-4 border-b border-surface-border md:border-r col-span-2 md:col-span-1">
          <dt class="eyebrow mb-1.5">Dosage</dt>
          <dd class="font-mono text-ink">{s.dosage}</dd>
        </div>
        <div class="p-4 border-b border-r border-surface-border">
          <dt class="eyebrow mb-1.5">Frequency</dt>
          <dd class="text-ink">{s.frequency}</dd>
        </div>
        <div class="p-4 border-b border-surface-border">
          <dt class="eyebrow mb-1.5">Time</dt>
          <dd><TimeLabel supplement={s} />{timeNote && <span class="block mt-1 text-xs text-ink-muted">{timeNote}</span>}</dd>
        </div>
        <div class="p-4 border-r border-surface-border max-md:border-b">
          <dt class="eyebrow mb-1.5">Meals</dt>
          <dd><MealLabel supplement={s} />{mealNote && <span class="block mt-1 text-xs text-ink-muted">{mealNote}</span>}</dd>
        </div>
        <div class="p-4 md:border-r border-surface-border max-md:border-b">
          <dt class="eyebrow mb-1.5">Adderall</dt>
          <dd><AdderallLabel supplement={s} long /><span class="block mt-1 text-xs text-ink-muted">{s.withAdderall}</span></dd>
        </div>
        <div class="p-4 col-span-2 md:col-span-1">
          <dt class="eyebrow mb-1.5">Schedule</dt>
          <dd><ScheduleLabel supplement={s} /></dd>
        </div>
      </dl>
    </section>

    <dl class="space-y-6 mb-10 max-w-2xl">
      <div>
        <dt class="eyebrow mb-1.5">Helps with</dt>
        <dd class="text-[0.9375rem] text-ink-soft">{s.treats}</dd>
      </div>
      <div>
        <dt class="eyebrow mb-1.5">Benefits</dt>
        <dd class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.benefits}</dd>
      </div>
      <div>
        <dt class="eyebrow mb-1.5">Side effects</dt>
        <dd class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.sideEffects}</dd>
      </div>
      <div>
        <dt class="eyebrow mb-1.5">Notes</dt>
        <dd class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.notes}</dd>
      </div>
    </dl>

    {related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related" class="eyebrow mb-2">Related</h2>
        <ul class="panel divide-y divide-surface-border overflow-hidden">
          {related.map((r) => (
            <li>
              <a
                href={`/supplement/${r.slug}`}
                class="flex items-center gap-3 px-4 py-3 hover:bg-surface-hover transition-colors focus-ring"
              >
                <TierIcon tier={r.tier} />
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-semibold text-ink">{r.name}</span>
                  {r.form && <span class="block text-xs text-ink-muted">{r.form}</span>}
                </span>
                <span class="text-ink-faint" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
