---
import Layout from "../../layouts/Layout.astro";
import SupplementDetail from "../../components/supplements/SupplementDetail";
import { supplements, type Supplement } from "../../data/supplements";
import { getRelatedSupplements } from "../../lib/supplement-utils";
import { classifyTimeOfDay, classifyMeals, getTimeLabel, getMealLabel } from "../../lib/format-utils";
import { tierLabels, tierDescriptions } from "../../lib/constants";
import { TierBadge, AdderallBadge, ScheduleBadge, TimeBadge, MealBadge } from "../../components/ui/SupplementBadges";

export function getStaticPaths() {
  return supplements.map((s) => ({
    params: { slug: s.slug },
    props: { supplement: s },
  }));
}

interface Props {
  supplement: Supplement;
}

const { supplement: s } = Astro.props;
const related = getRelatedSupplements(s, 4);
const timeType = classifyTimeOfDay(s.timeOfDay);
const mealType = classifyMeals(s.withMeals);

// Fetch price for this supplement
let price: number | undefined;
if (s.purchaseUrl) {
  try {
    const handleMatch = s.purchaseUrl.match(/\/p\/([^?]+)/);
    if (handleMatch) {
      const res = await fetch(`https://www.swansonvitamins.com/products/${handleMatch[1]}.json`);
      if (res.ok) {
        const data = await res.json();
        const variantId = s.purchaseUrl.match(/variant=(\d+)/)?.[1];
        const variant = data.product?.variants?.find((v: any) => String(v.id) === variantId);
        if (variant?.price) price = parseFloat(variant.price);
      }
    }
  } catch { /* graceful fallback */ }
}

// Show the raw text under a badge only when it adds information
const timeNote = timeType && s.timeOfDay !== getTimeLabel(timeType) ? s.timeOfDay : null;
const mealNote = mealType && s.withMeals !== getMealLabel(mealType) ? s.withMeals : null;
---

<Layout title={`${s.name} — ADHD Supplement Database`} description={`${s.name}: ${s.treats}. ${s.benefits}`}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-4 sm:pt-8 pb-12">
    <a href="/" class="inline-flex items-center gap-1.5 min-h-11 -ml-1 px-1 text-sm text-ink-muted hover:text-ink transition-colors focus-ring">
      <span aria-hidden="true">←</span> All supplements
    </a>

    <!-- Hero -->
    <header class="mt-2 mb-6 sm:mb-8">
      <p class="eyebrow mb-2">{s.category}</p>
      <h1 class="font-serif text-[2rem] leading-[1.1] sm:text-5xl font-semibold mb-4">{s.name}</h1>
      <div class="flex flex-wrap gap-1.5 mb-5">
        <TierBadge supplement={s} />
        <ScheduleBadge supplement={s} />
        <AdderallBadge supplement={s} />
      </div>
      <p class="max-w-2xl font-body text-[1.0625rem] leading-relaxed text-ink-soft border-l-2 pl-4" style={`border-color: var(--color-tier${s.tier})`}>
        <span class="font-display text-sm font-semibold" style={`color: var(--color-tier${s.tier}-text)`}>Why {tierLabels[s.tier]}.</span>
        {" "}{s.tierReason}
      </p>
    </header>

    <!-- Buy (React island) -->
    {s.purchaseUrl && (
      <section class="panel p-4 mb-6" aria-label="Buy">
        <SupplementDetail supplement={s} price={price} client:visible />
      </section>
    )}

    <!-- At a glance -->
    <section class="panel mb-8" aria-labelledby="glance">
      <h2 id="glance" class="sr-only">At a glance</h2>
      <dl class="grid grid-cols-2 md:grid-cols-3">
        <div class="p-4 border-b border-surface-border md:border-r col-span-2 md:col-span-1">
          <dt class="eyebrow mb-1.5">Dosage</dt>
          <dd class="font-mono text-sm text-ink">{s.dosage}</dd>
        </div>
        <div class="p-4 border-b border-r border-surface-border">
          <dt class="eyebrow mb-1.5">Frequency</dt>
          <dd class="text-sm text-ink">{s.frequency}</dd>
        </div>
        <div class="p-4 border-b border-surface-border">
          <dt class="eyebrow mb-1.5">Time of day</dt>
          <dd class="text-sm"><TimeBadge supplement={s} />{timeNote && <span class="block mt-1.5 text-xs text-ink-muted">{timeNote}</span>}</dd>
        </div>
        <div class="p-4 border-r border-surface-border max-md:border-b">
          <dt class="eyebrow mb-1.5">With meals</dt>
          <dd class="text-sm"><MealBadge supplement={s} />{mealNote && <span class="block mt-1.5 text-xs text-ink-muted">{mealNote}</span>}</dd>
        </div>
        <div class="p-4 md:border-r border-surface-border max-md:border-b">
          <dt class="eyebrow mb-1.5">With Adderall</dt>
          <dd class="text-sm"><AdderallBadge supplement={s} /><span class="block mt-1.5 text-xs text-ink-muted">{s.withAdderall}</span></dd>
        </div>
        <div class="p-4 col-span-2 md:col-span-1">
          <dt class="eyebrow mb-1.5">Schedule</dt>
          <dd class="text-sm"><ScheduleBadge supplement={s} /></dd>
        </div>
      </dl>
    </section>

    <!-- Prose -->
    <div class="space-y-7 mb-10 max-w-2xl">
      <section>
        <h2 class="eyebrow !text-ink-muted mb-2.5">Helps with</h2>
        <ul class="flex flex-wrap gap-1.5">
          {s.treats.split(",").map((t: string) => (
            <li class="badge !text-ink-soft !text-[0.8125rem] !px-2.5 !py-1">{t.trim()}</li>
          ))}
        </ul>
      </section>
      <section>
        <h2 class="eyebrow !text-ink-muted mb-2">Benefits</h2>
        <p class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.benefits}</p>
      </section>
      <section>
        <h2 class="eyebrow !text-ink-muted mb-2">Side effects</h2>
        <p class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.sideEffects}</p>
      </section>
      <section>
        <h2 class="eyebrow !text-ink-muted mb-2">Notes</h2>
        <p class="font-body text-[1.0625rem] leading-relaxed text-ink-soft">{s.notes}</p>
      </section>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <section aria-labelledby="related">
        <h2 id="related" class="font-serif text-xl font-semibold mb-3">Related supplements</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {related.map((r) => (
            <li>
              <a
                href={`/supplement/${r.slug}`}
                class="relative flex items-center justify-between gap-3 panel overflow-hidden pl-4 pr-3 py-3 hover:border-surface-500 transition-colors focus-ring"
              >
                <span class={`absolute inset-y-0 left-0 w-[3px] tier-bar-${r.tier}`} aria-hidden="true"></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-ink truncate">{r.name}</span>
                  <span class="block text-xs text-ink-muted truncate">{r.treats}</span>
                </span>
                <span class="text-ink-faint shrink-0" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Layout>
